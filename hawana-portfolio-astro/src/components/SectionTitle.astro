---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, text, align = 'left' } = Astro.props;
---
<div class:list={['section-title', `align-${align}`]}>
  <p class="eyebrow reveal-up">{eyebrow}</p>
  <h2 class="split-heading" data-split>{title}</h2>
  {text && <p class="section-lead reveal-up">{text}</p>}
</div>
