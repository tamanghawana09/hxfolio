---
import Icon from './Icon.astro';
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  meta?: string;
}
const { eyebrow, title, text, meta } = Astro.props;
---
<section class="page-hero section" data-page-hero>
  <div class="page-hero-orb orb orb-one"></div>
  <div class="page-hero-orb orb orb-two"></div>
  <div class="shell page-hero-grid">
    <div>
      <p class="eyebrow hero-reveal"><Icon name="spark" size={16} /> {eyebrow}</p>
      <h1 class="page-title hero-reveal">{title}</h1>
    </div>
    <div class="page-hero-copy hero-reveal">
      <p>{text}</p>
      {meta && <span>{meta}</span>}
    </div>
  </div>
</section>
