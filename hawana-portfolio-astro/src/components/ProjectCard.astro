---
import Icon from './Icon.astro';
import type { Project } from '../data/site';
interface Props { project: Project; compact?: boolean; }
const { project, compact = false } = Astro.props;
---
<article class:list={['project-card', `accent-${project.accent}`, { compact }]} data-project-card>
  <div class="project-visual">
    <div class="project-gridlines"></div>
    <span class="project-number">{project.number}</span>
    <span class="project-type">{project.type}</span>
    <div class="visual-window">
      <div class="visual-window-bar"><i></i><i></i><i></i></div>
      <div class="visual-code-lines">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="visual-pill">{project.tags[0]}</div>
    </div>
    <div class="project-glow"></div>
  </div>
  <div class="project-content">
    <div>
      <p class="project-kicker">{project.type}</p>
      <h3>{project.title}</h3>
      <p>{project.description}</p>
    </div>
    {!compact && (
      <ul class="project-details">
        {project.details.map((detail) => <li>{detail}</li>)}
      </ul>
    )}
    <div class="tag-list">
      {project.tags.map((tag) => <span>{tag}</span>)}
    </div>
    <a class="text-link magnetic" href={project.href} target="_blank" rel="noreferrer">
      {project.linkLabel}<Icon name="arrow-up-right" size={18} />
    </a>
  </div>
</article>
