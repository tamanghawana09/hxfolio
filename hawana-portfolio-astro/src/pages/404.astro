---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Page not found | Hawana Tamang" noindex>
  <section class="not-found section">
    <div class="not-found-aura"></div>
    <div class="shell not-found-inner">
      <span>404</span>
      <h1>This route returned nothing useful.</h1>
      <p>The page may have moved, or the URL may be wrong. The rest of the portfolio is still intact.</p>
      <a class="button button-primary" href="/">Return home <Icon name="arrow-right" /></a>
    </div>
  </section>
</BaseLayout>
